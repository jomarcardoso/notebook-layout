{
  "name": "notebook-layout",
  "version": "1.0.0",
  "description": "Design your application to look like a notebook.",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate:paper-textures": "node scripts/generate-texture-bg.mjs",
    "prestorybook": "npm run generate:paper-textures",
    "prebuild-storybook": "npm run generate:paper-textures",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:tokens": "npm run build:coreui && sass --no-source-map --load-path=styles/ds styles/ds/tokens.scss /dev/null && sass --no-source-map --style=compressed --load-path=styles/ds styles/ds/ds.scss styles/ds/dist/ds.css",
    "lint:layers": "npx stylelint \"components/**/*.scss\" \"styles/**/*.scss\" --config stylelint.config.cjs",
    "build:coreui": "sass --no-source-map --style=compressed --quiet-deps --silence-deprecation=import --load-path=../www/node_modules styles/ds/coreui-entry.scss styles/ds/dist/coreui.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomarcardoso/notebook-layout.git"
  },
  "author": "Jomar A. Cardoso",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/jomarcardoso/notebook-layout/issues"
  },
  "homepage": "https://github.com/jomarcardoso/notebook-layout#readme",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-onboarding": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss-scss": "^4.0.9",
    "react-docgen-typescript-plugin": "^1.0.8",
    "sass": "^1.104.0",
    "sharp": "^0.35.2",
    "storybook": "^9.1.10",
    "stylelint": "^16.26.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "ovos": "^1.3.3",
    "react-icons": "^5.5.0",
    "the-new-css-reset": "^1.11.3"
  }
}
